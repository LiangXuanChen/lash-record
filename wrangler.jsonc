{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "lash-record",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-15",

  "vars": {
    "FRONTEND_URL": "https://liangxuanchen.github.io/lash-record/"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lash-record-db",
      "database_id": "10b5d6dc-531a-4662-ac29-aad4fc9bd825",
      "migrations_dir": "migrations"
    }
  ]
}
